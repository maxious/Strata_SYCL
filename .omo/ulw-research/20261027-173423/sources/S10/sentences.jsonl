{"sid":"S10:s1","start":0,"end":32,"text":"#ifndef GGML_SYCL_FUSED_GEMM_HPP"}
{"sid":"S10:s2","start":33,"end":65,"text":"#define GGML_SYCL_FUSED_GEMM_HPP"}
{"sid":"S10:s3","start":67,"end":88,"text":"#include \"common.hpp\""}
{"sid":"S10:s4","start":91,"end":137,"text":"// Shape and type gates for the kernels below."}
{"sid":"S10:s5","start":138,"end":193,"text":"Device capability is separate: it needs a queue to ask."}
{"sid":"S10:s6","start":194,"end":296,"text":"static constexpr int GGML_SYCL_FG_MAX_N = 64; // widest N taken; each shape covers it in BN-wide tiles"}
{"sid":"S10:s7","start":298,"end":375,"text":"// weight formats the fused A stage decodes; K must cover whole stored blocks"}
{"sid":"S10:s8","start":376,"end":461,"text":"constexpr bool ggml_sycl_fused_dequant_gemm_type_ok(ggml_type src0_type, int64_t K) {"}
{"sid":"S10:s9","start":466,"end":561,"text":"// iq4_nl and q8_0 store 32 values per block; every other format here is a 256-value superblock"}
{"sid":"S10:s10","start":566,"end":642,"text":"// that the A stage walks in steps of 32, so K must cover whole superblocks."}
{"sid":"S10:s11","start":647,"end":714,"text":"if (src0_type == GGML_TYPE_IQ4_NL || src0_type == GGML_TYPE_Q8_0) {"}
{"sid":"S10:s12","start":723,"end":742,"text":"return K % 32 == 0;"}
{"sid":"S10:s13","start":747,"end":748,"text":"}"}
{"sid":"S10:s14","start":753,"end":776,"text":"const bool superblock ="}
{"sid":"S10:s15","start":788,"end":818,"text":"src0_type == GGML_TYPE_Q4_K ||"}
{"sid":"S10:s16","start":830,"end":860,"text":"src0_type == GGML_TYPE_Q5_K ||"}
{"sid":"S10:s17","start":872,"end":902,"text":"src0_type == GGML_TYPE_Q6_K ||"}
{"sid":"S10:s18","start":914,"end":945,"text":"src0_type == GGML_TYPE_IQ3_S ||"}
{"sid":"S10:s19","start":957,"end":989,"text":"src0_type == GGML_TYPE_IQ4_XS ||"}
{"sid":"S10:s20","start":1001,"end":1034,"text":"src0_type == GGML_TYPE_IQ3_XXS ||"}
{"sid":"S10:s21","start":1046,"end":1079,"text":"src0_type == GGML_TYPE_IQ2_XXS ||"}
{"sid":"S10:s22","start":1091,"end":1123,"text":"src0_type == GGML_TYPE_IQ2_XS ||"}
{"sid":"S10:s23","start":1135,"end":1166,"text":"src0_type == GGML_TYPE_IQ2_S ||"}
{"sid":"S10:s24","start":1178,"end":1209,"text":"src0_type == GGML_TYPE_IQ1_S ||"}
{"sid":"S10:s25","start":1221,"end":1250,"text":"src0_type == GGML_TYPE_IQ1_M;"}
{"sid":"S10:s26","start":1255,"end":1305,"text":"return superblock && QK_K == 256 && K % QK_K == 0;"}
{"sid":"S10:s27","start":1306,"end":1307,"text":"}"}
{"sid":"S10:s28","start":1309,"end":1415,"text":"constexpr bool ggml_sycl_fused_dequant_gemm_shape_ok(ggml_type src0_type, int64_t M, int64_t N, int64_t K,"}
{"sid":"S10:s29","start":1469,"end":1483,"text":"int64_t ldd) {"}
{"sid":"S10:s30","start":1488,"end":1575,"text":"return ggml_sycl_fused_dequant_gemm_type_ok(src0_type, K) && M > 0 && N > 0 && K > 0 &&"}
{"sid":"S10:s31","start":1587,"end":1613,"text":"N <= GGML_SYCL_FG_MAX_N &&"}
{"sid":"S10:s32","start":1625,"end":1696,"text":"M <= INT32_MAX && N <= INT32_MAX && K <= INT32_MAX && ldd <= INT32_MAX;"}
{"sid":"S10:s33","start":1697,"end":1698,"text":"}"}
{"sid":"S10:s34","start":1700,"end":1793,"text":"// grouped variant: the per-expert fused kernel is only worth it while each expert is narrow,"}
{"sid":"S10:s35","start":1794,"end":1865,"text":"// so wider average slices are left to the per-expert library GEMM loop"}
{"sid":"S10:s36","start":1866,"end":1963,"text":"constexpr bool ggml_sycl_grouped_dequant_gemm_shape_ok(ggml_type src0_type, int64_t M, int64_t K,"}
{"sid":"S10:s37","start":2019,"end":2058,"text":"int64_t total_rows, int64_t n_active) {"}
{"sid":"S10:s38","start":2063,"end":2151,"text":"return ggml_sycl_fused_dequant_gemm_shape_ok(src0_type, M, 1, K, M) && total_rows > 0 &&"}
{"sid":"S10:s39","start":2163,"end":2234,"text":"total_rows <= INT32_MAX && total_rows <= n_active * GGML_SYCL_FG_MAX_N;"}
{"sid":"S10:s40","start":2235,"end":2236,"text":"}"}
{"sid":"S10:s41","start":2238,"end":2322,"text":"// Runtime type gate, kept out of the constexpr predicates above so those stay pure."}
{"sid":"S10:s42","start":2323,"end":2391,"text":"inline bool ggml_sycl_xmx_gather_type_enabled(ggml_type src0_type) {"}
{"sid":"S10:s43","start":2396,"end":2416,"text":"switch (src0_type) {"}
{"sid":"S10:s44","start":2425,"end":2524,"text":"case GGML_TYPE_IQ4_NL:  return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_IQ4_NL  ) != 0;"}
{"sid":"S10:s45","start":2533,"end":2632,"text":"case GGML_TYPE_IQ3_S:   return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_IQ3_S   ) != 0;"}
{"sid":"S10:s46","start":2641,"end":2740,"text":"case GGML_TYPE_IQ4_XS:  return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_IQ4_XS  ) != 0;"}
{"sid":"S10:s47","start":2749,"end":2848,"text":"case GGML_TYPE_IQ3_XXS: return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_IQ3_XXS ) != 0;"}
{"sid":"S10:s48","start":2857,"end":2956,"text":"case GGML_TYPE_IQ2_XXS: return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_IQ2_XXS ) != 0;"}
{"sid":"S10:s49","start":2965,"end":3064,"text":"case GGML_TYPE_IQ2_XS:  return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_IQ2_XS  ) != 0;"}
{"sid":"S10:s50","start":3073,"end":3172,"text":"case GGML_TYPE_IQ2_S:   return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_IQ2_S   ) != 0;"}
{"sid":"S10:s51","start":3181,"end":3280,"text":"case GGML_TYPE_IQ1_S:   return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_IQ1_S   ) != 0;"}
{"sid":"S10:s52","start":3289,"end":3388,"text":"case GGML_TYPE_IQ1_M:   return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_IQ1_M   ) != 0;"}
{"sid":"S10:s53","start":3397,"end":3496,"text":"case GGML_TYPE_Q8_0:    return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_Q8_0    ) != 0;"}
{"sid":"S10:s54","start":3505,"end":3604,"text":"case GGML_TYPE_Q4_K:    return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_Q4_K    ) != 0;"}
{"sid":"S10:s55","start":3613,"end":3712,"text":"case GGML_TYPE_Q5_K:    return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_Q5_K    ) != 0;"}
{"sid":"S10:s56","start":3721,"end":3820,"text":"case GGML_TYPE_Q6_K:    return (g_ggml_sycl_xmx_gather_types & GGML_SYCL_XMX_GATHER_Q6_K    ) != 0;"}
{"sid":"S10:s57","start":3829,"end":3860,"text":"default:          return false;"}
{"sid":"S10:s58","start":3865,"end":3866,"text":"}"}
{"sid":"S10:s59","start":3867,"end":3868,"text":"}"}
{"sid":"S10:s60","start":3870,"end":3961,"text":"// dst[n*ldd + m] = sum_k dequant(src0)[m*K + k] * src1[n*K + k], src1 is F32, F16 or BF16."}
{"sid":"S10:s61","start":3962,"end":4058,"text":"// The XMX combination is picked per call from the src1 type and its precision request src1_prec"}
{"sid":"S10:s62","start":4059,"end":4143,"text":"// (op_params[3], [TAG_GGML_PREC]); the accumulator is f32, which meets any request."}
{"sid":"S10:s63","start":4144,"end":4222,"text":"// q8_0 and the k-quants are not handled here, only in the grouped path below."}
{"sid":"S10:s64","start":4223,"end":4305,"text":"// Returns false when the case is not handled (type, device, precision, or shape)."}
{"sid":"S10:s65","start":4306,"end":4440,"text":"bool ggml_sycl_fused_dequant_gemm(ggml_type src0_type, bool src0_reordered, const void * src0, const void * src1, ggml_type src1_type,"}
{"sid":"S10:s66","start":4475,"end":4552,"text":"int32_t src1_prec, float * dst, int64_t M, int64_t N, int64_t K, int64_t ldd,"}
{"sid":"S10:s67","start":4587,"end":4634,"text":"ggml_sycl_pool & pool, dpct::queue_ptr stream);"}
{"sid":"S10:s68","start":4636,"end":4732,"text":"// One launch for every expert of a MUL_MAT_ID: rows of src1/dst are grouped by expert, expert e"}
{"sid":"S10:s69","start":4733,"end":4819,"text":"// owns rows [expert_row_offsets[e], expert_row_offsets[e+1]) and reads its weights at"}
{"sid":"S10:s70","start":4820,"end":4851,"text":"// src0_base + e*expert_stride."}
{"sid":"S10:s71","start":4852,"end":4918,"text":"tiles is host scratch that must stay alive until the queue drains."}
{"sid":"S10:s72","start":4919,"end":4998,"text":"// reordered: each expert slice is in the reorder (SoA) layout of reorder_qw()."}
{"sid":"S10:s73","start":4999,"end":5063,"text":"// dst[n*M + m] = sum_k dequant(src0_e)[m*K + k] * src1[n*K + k]"}
{"sid":"S10:s74","start":5064,"end":5154,"text":"// Returns false when the case is not handled (type, layout, device, precision, or shape)."}
{"sid":"S10:s75","start":5155,"end":5273,"text":"bool ggml_sycl_grouped_dequant_gemm(ggml_type src0_type, bool reordered, const void * src0_base, size_t expert_stride,"}
{"sid":"S10:s76","start":5310,"end":5361,"text":"const float * src1, int32_t src1_prec, float * dst,"}
{"sid":"S10:s77","start":5398,"end":5469,"text":"const int64_t * expert_row_offsets, int64_t n_as, int64_t M, int64_t K,"}
{"sid":"S10:s78","start":5506,"end":5565,"text":"int64_t total_rows, std::vector<ggml_sycl_gg_tile> & tiles,"}
{"sid":"S10:s79","start":5602,"end":5649,"text":"ggml_sycl_pool & pool, dpct::queue_ptr stream);"}
{"sid":"S10:s80","start":5651,"end":5685,"text":"#endif // GGML_SYCL_FUSED_GEMM_HPP"}
